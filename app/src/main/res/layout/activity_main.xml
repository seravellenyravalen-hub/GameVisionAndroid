<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gv_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_gamevision_logo"
            android:contentDescription="GameVision" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GAMEVISION" android:textColor="@color/gv_text" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEE • UNDERSTAND • ACT" android:textColor="@color/gv_muted" android:textSize="9sp" android:letterSpacing="0.08" />
        </LinearLayout>
        <TextView android:id="@+id/headerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_lime_button" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="READY" android:textColor="@color/gv_bg" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout android:id="@+id/pageContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/homePage" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="28dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Your visual game companion" android:textColor="@color/gv_text" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Give GameVision a goal. It can see the visible screen, reason about what is happening, and act through Android's approved controls." android:textColor="@color/gv_muted" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="17dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="AI ENGINE" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1" /><TextView android:id="@+id/aiBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● READY" android:textColor="@color/gv_lime" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>
                    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Ready to see, understand and act." android:textColor="@color/gv_text" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/visionAiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Free vision AI is available." android:textColor="@color/gv_muted" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="QUICK ACTIONS" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
                    <Button android:id="@+id/homeMonitorButton" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/bg_card" android:text="MONITOR\n\nScreen vision" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" />
                    <Button android:id="@+id/homeAssistantButton" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:background="@drawable/bg_card" android:text="ASSISTANT\n\nTalk or type" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" />
                    <Button android:id="@+id/homeAutoButton" android:layout_width="0dp" android:layout_height="88dp" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_card" android:text="AUTO\n\nAct for me" android:textColor="@color/gv_lime" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MONITORING" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/homeMonitorState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Not monitoring" android:textColor="@color/gv_text" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="GameVision uses the visible screen only. Start monitoring when you are ready." android:textColor="@color/gv_muted" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RECENT ACTIVITY" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/homeActivityPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="No actions in this session yet." android:textColor="@color/gv_text" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/assistantPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Assistant" android:textColor="@color/gv_text" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Talk naturally. Ask what GameVision sees, give it a goal, or tell it to act on the current screen." android:textColor="@color/gv_muted" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FLOATING ASSISTANT" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="The G/V assistant stays above your game so you can send commands without leaving it." android:textColor="@color/gv_text" android:textSize="15sp" /><Button android:id="@+id/assistantLaunchButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/bg_lime_button" android:text="OPEN G/V ASSISTANT" android:textColor="@color/gv_bg" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMMANDS" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Examples: “tap the play button”, “swipe down”, “what is on screen?”, “open settings”, or “play this for me”." android:textColor="@color/gv_text" android:textSize="13sp" /></LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/monitorPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monitor" android:textColor="@color/gv_text" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Give GameVision a live view of the screen you approve." android:textColor="@color/gv_muted" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCREEN CAPTURE" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" /><TextView android:id="@+id/monitorState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="STOPPED" android:textColor="@color/gv_text" android:textSize="21sp" android:textStyle="bold" /><TextView android:id="@+id/monitorDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Waiting for screen sharing approval." android:textColor="@color/gv_muted" android:textSize="12sp" /></LinearLayout>
                <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/bg_lime_button" android:text="START MONITORING" android:textColor="@color/gv_bg" android:textSize="12sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal"><Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/bg_outline_button" android:text="STOP" android:textColor="@color/gv_red" android:textSize="11sp" android:textStyle="bold" /><Button android:id="@+id/hudButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_outline_button" android:text="HUD" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>
                <Button android:id="@+id/monitorOverlayButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_outline_button" android:text="DISPLAY OVER OTHER APPS" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" />
                <Button android:id="@+id/monitorAccessibilityButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_outline_button" android:text="AUTO CONTROL ACCESS" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/activityPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity" android:textColor="@color/gv_text" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="What GameVision has done during this session." android:textColor="@color/gv_muted" android:textSize="13sp" />
                <TextView android:id="@+id/activityEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_card" android:padding="18dp" android:text="No activity yet. Start monitoring or open the assistant to begin." android:textColor="@color/gv_muted" android:textSize="13sp" />
                <TextView android:id="@+id/activityLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:padding="18dp" android:textColor="@color/gv_text" android:textSize="12sp" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/settingsPage" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:paddingBottom="30dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="@color/gv_text" android:textSize="25sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Control how GameVision connects to Android and how the assistant behaves." android:textColor="@color/gv_muted" android:textSize="13sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="PERMISSIONS &amp; ACCESS" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <Button android:id="@+id/overlayButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="9dp" android:background="@drawable/bg_outline_button" android:text="DISPLAY OVER OTHER APPS" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" />
                <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_outline_button" android:text="GAMEVISION AUTO CONTROL" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/permissionSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Checking access…" android:textColor="@color/gv_muted" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="ASSISTANT" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Voice + text commands" android:textColor="@color/gv_text" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Use the floating assistant to talk, type, ask questions, or request an action." android:textColor="@color/gv_muted" android:textSize="11sp" /></LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="AUTOMATION" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Supported actions" android:textColor="@color/gv_text" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tap • double tap • long press • swipe • drag • pinch • two-finger swipe • type text • navigation actions" android:textColor="@color/gv_muted" android:textSize="11sp" /></LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="ABOUT" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GameVision" android:textColor="@color/gv_text" android:textSize="15sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="General visual game companion" android:textColor="@color/gv_muted" android:textSize="11sp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Version 1.1.0" android:textColor="@color/gv_lime" android:textSize="12sp" android:textStyle="bold" /></LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/gv_surface" android:gravity="center_vertical" android:weightSum="5">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_home" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Home" android:textColor="@color/gv_text" android:textSize="9sp" /></LinearLayout>
        <LinearLayout android:id="@+id/navAssistant" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_assistant" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Assistant" android:textColor="@color/gv_muted" android:textSize="9sp" /></LinearLayout>
        <LinearLayout android:id="@+id/navMonitor" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_monitor" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Monitor" android:textColor="@color/gv_muted" android:textSize="9sp" /></LinearLayout>
        <LinearLayout android:id="@+id/navActivity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_activity" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Activity" android:textColor="@color/gv_muted" android:textSize="9sp" /></LinearLayout>
        <LinearLayout android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_settings" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Settings" android:textColor="@color/gv_muted" android:textSize="9sp" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
