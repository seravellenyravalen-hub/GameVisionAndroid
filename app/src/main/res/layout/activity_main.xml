<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gv_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="GameVision logo" android:src="@drawable/ic_gamevision_logo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GAMEVISION" android:textColor="@color/gv_text" android:textSize="21sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="SEE. UNDERSTAND. ACT." android:textColor="@color/gv_muted" android:textSize="10sp" android:letterSpacing="0.08" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_lime_button" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="LIVE AI" android:textColor="@color/gv_bg" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MONITORING STATUS" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ready to monitor" android:textColor="@color/gv_text" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Capture the complete visible screen. GameVision is designed to adapt to different games instead of assuming a specific genre." android:textColor="@color/gv_muted" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="15dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCREEN" android:textColor="@color/gv_muted" android:textSize="9sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="FULL VIEW" android:textColor="@color/gv_green" android:textSize="15sp" android:textStyle="bold" /></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="15dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VISION AI" android:textColor="@color/gv_muted" android:textSize="9sp" android:textStyle="bold" /><TextView android:id="@+id/visionAiStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="CHECKING…" android:textColor="@color/gv_lime" android:textSize="15sp" android:textStyle="bold" /></LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="ANALYSIS SERVER" android:textColor="@color/gv_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
        <EditText android:id="@+id/serverUrl" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:inputType="textUri" android:paddingStart="15dp" android:paddingEnd="15dp" android:singleLine="true" android:text="https://gamevision-api-live-production.up.railway.app" android:textColor="@color/gv_text" android:textSize="12sp" />

        <Button android:id="@+id/overlayButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/bg_outline_button" android:text="ENABLE DISPLAY OVER OTHER APPS" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" />
        <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_outline_button" android:text="ENABLE GAMEVISION AUTO CONTROL" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="AUTO is optional. Android requires you to explicitly enable GameVision Accessibility before it can perform taps, swipes, drags, or long presses." android:textColor="@color/gv_muted" android:textSize="11sp" />

        <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/bg_lime_button" android:text="START GAMEVISION MONITOR" android:textColor="@color/gv_bg" android:textSize="12sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal"><Button android:id="@+id/stopButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_outline_button" android:text="STOP" android:textColor="@color/gv_red" android:textSize="11sp" android:textStyle="bold" /><Button android:id="@+id/hudButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_outline_button" android:text="TOGGLE HUD" android:textColor="@color/gv_text" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="15dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI ASSISTANT" android:textColor="@color/gv_muted" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Open the floating G/V assistant to have a normal conversation. Type or speak a goal, ask what is visible, or switch to AUTO when you want GameVision to interact with the current game." android:textColor="@color/gv_muted" android:textSize="11sp" android:lineSpacingExtra="2dp" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="15dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRIVACY &amp; CONTROL" android:textColor="@color/gv_muted" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="GameVision captures only after you approve Android screen sharing. Frames are sent to your configured analysis server. AUTO control is never silently enabled and can be stopped from the floating assistant. No game memory access is used." android:textColor="@color/gv_muted" android:textSize="11sp" android:lineSpacingExtra="2dp" /></LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="GAMEVISION • GENERAL VISUAL GAME AGENT" android:textColor="@color/gv_stroke" android:textSize="9sp" android:letterSpacing="0.08" />
    </LinearLayout>
</ScrollView>
